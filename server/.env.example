# ----------------------------------------------------
# 🕹️ Poke Arcade Server Environment Variables
# ----------------------------------------------------

PORT=3001

# CORS 허용 도메인 (콤마로 구분, 또는 * 로 전체 허용)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------
# 🧠 Google Gemini AI Configuration
# ----------------------------------------------------
# Google AI Studio 또는 Google Cloud에서 발급받은 Gemini API 키
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 모델명 (기본값: gemini-3.6-flash)
# 무료 티어 및 유료/사용자 보유 티어 모두 지원:
# - gemini-3.6-flash (최신 모델)
# - gemini-2.0-flash
# - gemini-1.5-flash
GEMINI_MODEL=gemini-3.5-flash-Lite
